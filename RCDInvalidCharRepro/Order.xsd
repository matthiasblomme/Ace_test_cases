<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:ord="http://example.org/repro/order"
    targetNamespace="http://example.org/repro/order"
    elementFormDefault="qualified">

    <!-- Minimal anonymous model. Only the OrderMessage/Body/Description path is
         needed to reproduce the case: a plain xs:string element that will hold the
         invalid 0x1A character. The point is that 0x1A is a legal xs:string VALUE,
         so Content and Value validation has nothing to object to. -->
    <xs:element name="OrderMessage">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Body">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Description" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
