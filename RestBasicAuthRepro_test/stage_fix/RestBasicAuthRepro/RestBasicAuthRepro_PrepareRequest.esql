CREATE COMPUTE MODULE RestBasicAuthRepro_PrepareRequest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		-- Tag the outbound request with the ACE version so it shows up in the mock log.
		-- This literal is set per build: 'v13' for the TEST_V13 BAR, 'v12' for TEST_V12.
		SET OutputRoot.HTTPRequestHeader."X-Ace-Version" = 'v12';
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
