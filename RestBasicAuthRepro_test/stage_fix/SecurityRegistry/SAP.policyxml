<?xml version="1.0" encoding="UTF-8"?>
<policies>
  <policy policyType="SecurityProfiles" policyName="SAP" policyTemplate="SecurityProfiles">
    <authentication>NONE</authentication>
    <authenticationConfig></authenticationConfig>
    <mapping>NONE</mapping>
    <mappingConfig></mappingConfig>
    <authorization>NONE</authorization>
    <authorizationConfig></authorizationConfig>
    <propagation>true</propagation>
    <idToPropagateToTransport>STATIC ID</idToPropagateToTransport>
    <transportPropagationConfig>sap_user</transportPropagationConfig>
    <keyStore>Reserved for future use</keyStore>
