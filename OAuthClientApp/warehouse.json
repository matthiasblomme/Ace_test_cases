{
  "openapi": "3.0.0",
  "info": {
    "title": "Warehouse API",
    "description": "Mock warehouse API protected by OAuth 2.0 client credentials.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:7801/mock/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "warehouseOAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "http://localhost:7801/mock/oauth/token",
            "scopes": {
              "read:stock": "Read warehouse stock",
              "write:stock": "Update warehouse stock"
            }
          }
        }
      }
    },
    "schemas": {
      "StockDetail": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "authorizationReceived": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/stock": {
      "get": {
        "operationId": "getStock",
        "summary": "Read warehouse stock",
        "security": [
          {
            "warehouseOAuth": [
              "read:stock"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Stock detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockDetail"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
