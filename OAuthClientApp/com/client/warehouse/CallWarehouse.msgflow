      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="210,150" computeExpression="esql://routine/com.client.warehouse#CallWarehouse_PrepareRequest.Main" computeMode="all">
