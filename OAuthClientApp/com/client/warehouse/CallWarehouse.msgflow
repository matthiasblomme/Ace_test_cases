      </nodes>
      <nodes xmi:type="ComIbmRESTRequest.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="380,150" definitionFile="warehouse.json" operationName="getStock" baseURL="http://localhost:7801/mock/api" policyUrl="{OAuthPolicies}:WarehouseAPI" timeoutForServer="120">
