BROKER SCHEMA RetryHTTPDispatcher

DECLARE MAX_ATTEMPTS    EXTERNAL INTEGER 5;
DECLARE RETRY_ID        EXTERNAL CHARACTER 'A1B2C3D4';
DECLARE DEFAULT_BACKOFF EXTERNAL INTEGER 10;

CREATE COMPUTE MODULE RetryHTTPDispatcher_BuildRetryPayload
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE attempt INTEGER 0;
        IF InputRoot.MQRFH2.usr.RetryAttempt IS NOT NULL THEN
            SET attempt = CAST(InputRoot.MQRFH2.usr.RetryAttempt AS INTEGER);
        END IF;
        SET attempt = attempt + 1;

        IF attempt > MAX_ATTEMPTS THEN
            SET OutputRoot = InputRoot;
            SET Environment.Variables.Retry.Decision = 'exhausted';
            SET Environment.Variables.Retry.Reason =
                COALESCE(Environment.Variables.Retry.Reason, 'unknown')
                || ' (max ' || CAST(MAX_ATTEMPTS AS CHARACTER) || ' attempts exceeded)';
            SET Environment.Variables.Retry.Attempt = attempt - 1;
            PROPAGATE TO TERMINAL 'out1';
            RETURN FALSE;
        END IF;

        SET OutputRoot = InputRoot;

        DECLARE rfh2Ref REFERENCE TO OutputRoot.MQRFH2;
        IF NOT LASTMOVE(rfh2Ref) THEN
            SET OutputRoot.MQMD.Format = MQFMT_RF_HEADER_2;
            CREATE NEXTSIBLING OF OutputRoot.MQMD DOMAIN 'MQRFH2';
            SET OutputRoot.MQRFH2.(MQRFH2.Field)Version        = 2;
            SET OutputRoot.MQRFH2.(MQRFH2.Field)Format         = MQFMT_STRING;
            SET OutputRoot.MQRFH2.(MQRFH2.Field)NameValueCCSID = 1208;
        END IF;

        SET OutputRoot.MQRFH2.usr.RetryAttempt      = attempt;
        SET OutputRoot.MQRFH2.usr.OriginalQueue     = COALESCE(InputRoot.MQRFH2.usr.OriginalQueue, 'APP.IN');
        SET OutputRoot.MQRFH2.usr.TargetEndpoint    = COALESCE(InputRoot.MQRFH2.usr.TargetEndpoint, 'http://localhost:9999/retry-test');
        SET OutputRoot.MQRFH2.usr.LastFailureReason = COALESCE(Environment.Variables.Retry.Reason, 'unknown');
        IF InputRoot.MQRFH2.usr.FirstFailureTimestamp IS NULL THEN
            SET OutputRoot.MQRFH2.usr.FirstFailureTimestamp = CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'IU');
        END IF;
        SET OutputRoot.MQRFH2.usr.LastFailureTimestamp = CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'IU');

        DECLARE backoffSec INTEGER DEFAULT_BACKOFF;
        CASE attempt
            WHEN 1 THEN SET backoffSec = 10;
            WHEN 2 THEN SET backoffSec = 20;
            WHEN 3 THEN SET backoffSec = 40;
            WHEN 4 THEN SET backoffSec = 80;
            ELSE        SET backoffSec = 160;
        END CASE;

        DECLARE fireTime GMTTIMESTAMP CURRENT_GMTTIMESTAMP;
        SET fireTime = fireTime + (INTERVAL '1' SECOND) * backoffSec;

        SET OutputLocalEnvironment.TimeoutRequest.Action         = 'SET';
        SET OutputLocalEnvironment.TimeoutRequest.Identifier     = RETRY_ID;
        SET OutputLocalEnvironment.TimeoutRequest.StartDate      = CAST(fireTime AS DATE);
        SET OutputLocalEnvironment.TimeoutRequest.StartTime      = CAST(fireTime AS TIME);
        SET OutputLocalEnvironment.TimeoutRequest.Count          = 1;
        SET OutputLocalEnvironment.TimeoutRequest.IgnoreMissed   = FALSE;
        SET OutputLocalEnvironment.TimeoutRequest.AllowOverwrite = TRUE;

        SET Environment.Variables.Retry.Attempt        = attempt;
        SET Environment.Variables.Retry.BackoffSeconds = backoffSec;
        SET Environment.Variables.Retry.NextFireTime   = fireTime;

        PROPAGATE TO TERMINAL 'out';
        RETURN FALSE;
    END;
END MODULE;
