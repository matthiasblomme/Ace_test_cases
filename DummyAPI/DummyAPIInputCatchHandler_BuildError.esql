

CREATE COMPUTE MODULE DummyAPIInputCatchHandler_BuildError
	-- An exception thrown inside an operation ends up on the REST API's catch
	-- terminal. The caller gets a JSON 500 instead of the input node's empty
	-- default; the cause stays out of the reply body because the Trace node in
	-- front of this one writes the exception list to the log.
	-- LocalEnvironment is copied because the reply node needs the request
	-- identifier it carries, and this node propagates its own copy.
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 500;
		CALL CopyMessageHeaders();
		CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');
		SET OutputRoot.JSON.Data.error = 'Internal server error';
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
