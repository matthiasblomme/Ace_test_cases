

CREATE COMPUTE MODULE AuthCheck_Check
	-- Gate in front of every operation except the health checks: the request must
	-- carry an Authorization header with a Basic or Bearer credential. This checks
	-- presence and scheme only. Verifying a token signature needs the identity
	-- provider's keys and belongs in a security profile on the HTTP input, not here.
	-- A rejected request leaves on out1 (the subflow's Output1) as a finished 401
	-- reply. LocalEnvironment is copied on both paths because the reply node needs
	-- the request identifier it carries, and this node propagates its own copy.
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputLocalEnvironment = InputLocalEnvironment;

		DECLARE authorizationHeader CHARACTER UPPER(TRIM(COALESCE(InputRoot.HTTPInputHeader."Authorization", '')));
		IF NOT (authorizationHeader LIKE 'BASIC %' OR authorizationHeader LIKE 'BEARER %') THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 401;
			CALL CopyMessageHeaders();
			SET OutputRoot.HTTPReplyHeader."WWW-Authenticate" = 'Basic, Bearer';
			CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');
			SET OutputRoot.JSON.Data.error = 'Unauthorized';
			SET OutputRoot.JSON.Data.message = 'An Authorization header with a Basic or Bearer credential is required';
			PROPAGATE TO TERMINAL 'out1';
			RETURN FALSE;
		END IF;

		SET OutputRoot = InputRoot;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
