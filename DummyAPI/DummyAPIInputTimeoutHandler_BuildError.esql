

CREATE COMPUTE MODULE DummyAPIInputTimeoutHandler_BuildError
	-- The HTTP timeout terminal fires when no reply was sent within the input
	-- node's timeout. For an HTTP input the reply status can be changed on this
	-- path through Destination.HTTP.ReplyStatusCode, so the caller gets a JSON 504
	-- rather than the default 500.
	-- LocalEnvironment is copied because the reply node needs the request
	-- identifier it carries, and this node propagates its own copy.
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 504;
		CALL CopyMessageHeaders();
		CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');
		SET OutputRoot.JSON.Data.error = 'Gateway timeout';
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
