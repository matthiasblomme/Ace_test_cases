
DECLARE ReplyKey EXTERNAL CHAR '';
DECLARE ReplyValue EXTERNAL CHAR '';

CREATE COMPUTE MODULE HttpReply_HttpReply
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CREATE LASTCHILD OF OutputRoot DOMAIN ('JSON');
		CREATE FIRSTCHILD OF OutputRoot.JSON NAME 'Data';
		
		SET OutputRoot.JSON.Data.{ReplyKey} = ReplyValue;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
